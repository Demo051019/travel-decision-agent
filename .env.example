# ============================================================
#  EdgeOne Makers Agent — 环境变量模板
# ============================================================
#  用法：
#     cp .env.example .env      # 然后填入真实值
#
#  ⚠️  .env 已被 .gitignore 忽略，禁止提交到仓库。
#      本文件（.env.example）只放占位符，任何真实 Key 都不得写入。
#
#  代码中的读取位置：
#     agents/chat/index.py  AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL / AI_GATEWAY_MODEL
#     agents/_amap.py       AMAP_API_KEY（兼容 AMAP_KEY）
# ============================================================


# ------------------------------------------------------------
# LLM 网关（必填）
# ------------------------------------------------------------
# OpenAI 兼容的 API Key。
#   · 用 Makers Models 内置模型：控制台 → Makers → Models → API Key 新建
#   · 用自建/第三方服务：填对应厂商的 Key（BYOK）
# 格式参考：sk-xxxxxxxxxxxxxxxx（不要加引号、不要带 "Bearer " 前缀）
AI_GATEWAY_API_KEY=your-api-key-here

# OpenAI 兼容网关的 Base URL，必须以 /v1 结尾（不带 /chat/completions）。
#   · Makers Models：https://ai-gateway.edgeone.link/v1
#   · 其他厂商：按其文档填写，如 https://api.openai.com/v1
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1


# ------------------------------------------------------------
# 模型名（选填）
# ------------------------------------------------------------
# 不填时代码内默认使用 @makers/deepseek-v4-flash（平台内置免费模型，有额度限制）。
# 换模型时按厂商前缀改写，例如：
#   · Makers Models 托管厂商：deepseek/deepseek-v4-flash
#   · 原生厂商：deepseek-v4-flash
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash


# ------------------------------------------------------------
# 高德地图（必填）
# ------------------------------------------------------------
# 用于「地点解析 / 周边商场检索 / 品牌门店核对 / 步行路径」。
# 申请：https://console.amap.com/dev/key/app
#   · 必须选「Web服务」类型的 Key，不能选「Web端(JS API)」或移动端
#   · 该 Key 需开通 Web 服务下的：地理编码、搜索 POI、路径规划
# 代码读取位置：agents/_amap.py（优先读取 AMAP_API_KEY，兼容旧名 AMAP_KEY）
AMAP_API_KEY=your-amap-key-here

# 旧命名兼容位，与上面填同一个值即可，两个都存在时以上面为准
# AMAP_KEY=your-amap-key-here
